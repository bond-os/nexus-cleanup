# Connection settings for running nexus-cleanup locally through varlock
# (https://varlock.dev): `varlock run -- docker run … --config configs/<name>.yaml`.
# The pipeline never reads this file; it takes the same variables from the CI system.
#
# This file is committed and holds no values. Put them in a gitignored .env.local, or
# resolve them: the password from the OS keychain with keychain(), from a prompt with
# varlock(prompt), or from a secret manager through a varlock plugin.
#
# Each item states whether it is required and sensitive, so nothing here depends on
# varlock's defaults.
# @defaultSensitive=false @defaultRequired=false
# ---

# Address of your Nexus, such as https://nexus.company.com
# @required @type=url
NEXUS_URL=

# Nexus user the tool signs in as
NEXUS_USERNAME=

# Password of that user. Never written here: use .env.local, keychain(),
# varlock(prompt) or a plugin.
# @required @sensitive
NEXUS_PASSWORD=
