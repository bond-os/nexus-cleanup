{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "nexus-cleanup",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "nexus-cleanup/version.nu"
        },
        {
          "type": "generic",
          "path": "examples/configs/yum-proxies.yaml"
        },
        {
          "type": "generic",
          "path": "examples/configs/raw-builds.yaml"
        },
        {
          "type": "generic",
          "path": "examples/configs/raw-hosted-builds.yaml"
        },
        {
          "type": "generic",
          "path": "examples/gitlab/.gitlab-ci.yml"
        },
        {
          "type": "generic",
          "path": "examples/gitlab/configs/example.yaml"
        },
        {
          "type": "generic",
          "path": "examples/gitlab/.vscode/settings.json"
        },
        {
          "type": "generic",
          "path": "examples/gitlab/.idea/jsonSchemas.xml"
        },
        {
          "type": "generic",
          "path": "examples/forgejo/.forgejo/workflows/nexus-cleanup.yml"
        },
        {
          "type": "generic",
          "path": "examples/forgejo/configs/example.yaml"
        },
        {
          "type": "generic",
          "path": "examples/forgejo/.vscode/settings.json"
        },
        {
          "type": "generic",
          "path": "examples/forgejo/.idea/jsonSchemas.xml"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-docker/Jenkinsfile"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-docker/configs/example.yaml"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-docker/.vscode/settings.json"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-docker/.idea/jsonSchemas.xml"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-sh/Jenkinsfile"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-sh/configs/example.yaml"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-sh/.vscode/settings.json"
        },
        {
          "type": "generic",
          "path": "examples/jenkins-sh/.idea/jsonSchemas.xml"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true }
      ]
    }
  }
}
