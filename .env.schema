# Connection to the reference Nexus, for tools/record-fixtures.nu and local smoke runs:
#
#   varlock run -- nu tools/record-fixtures.nu …
#
# Never read by the tool or its tests. Put the password in a gitignored .env.local, or
# resolve it with keychain(), varlock(prompt) or a plugin; exported variables still win.
# @defaultSensitive=false @defaultRequired=false
# ---

# The reference instance (see AGENTS.md, "Reference Nexus")
# @required @type=url
NEXUS_URL=http://localhost:8081

NEXUS_USERNAME=admin

# Never written here: use .env.local, keychain(), varlock(prompt) or a plugin.
# @required @sensitive
NEXUS_PASSWORD=
